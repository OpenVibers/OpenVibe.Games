{
  "name": "@openvibe/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --build",
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:pg --external:iovalkey --external:@electric-sql/pglite --external:quickjs-emscripten --outfile=dist/server.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "@electric-sql/pglite": "^0.5.8",
    "@openvibe/content": "workspace:*",
    "@openvibe/gameplay": "workspace:*",
    "@openvibe/persistence": "workspace:*",
    "@openvibe/physics": "workspace:*",
    "@openvibe/protocol": "workspace:*",
    "@openvibe/shared": "workspace:*",
    "ajv": "^8.17.1",
    "iovalkey": "^0.4.0",
    "openvibe-contracts": "https://codeload.github.com/OpenVibers/OpenVibe.Contracts/tar.gz/refs/tags/v0.112.0",
    "openvibe-sdk": "https://codeload.github.com/OpenVibers/OpenVibe.SDK/tar.gz/refs/tags/v0.35.0",
    "openvibe-shared": "https://codeload.github.com/OpenVibers/OpenVibe.Shared/tar.gz/refs/tags/v2.15.0",
    "pg": "^8.23.0",
    "quickjs-emscripten": "0.32.0",
    "tsx": "^4.19.3",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.2"
  }
}
