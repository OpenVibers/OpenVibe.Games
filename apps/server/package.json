{
  "name": "@openvibe/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --build",
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:better-sqlite3 --external:@babylonjs/havok --outfile=dist/server.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@babylonjs/havok": "^1.3.10",
    "@openvibe/content": "workspace:*",
    "@openvibe/gameplay": "workspace:*",
    "@openvibe/persistence": "workspace:*",
    "@openvibe/physics": "workspace:*",
    "@openvibe/protocol": "workspace:*",
    "@openvibe/shared": "workspace:*",
    "ajv": "^8.17.1",
    "better-sqlite3": "^11.9.1",
    "openvibe-contracts": "https://codeload.github.com/OpenVibers/OpenVibe.Contracts/tar.gz/refs/tags/v0.53.0",
    "openvibe-sdk": "https://codeload.github.com/OpenVibers/OpenVibe.SDK/tar.gz/refs/tags/v0.11.0",
    "tsx": "^4.19.3",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.2"
  }
}
